# Internal HTTP port only. Must be an integer between 1024 and 65535.
HTTP_PORT=8080
# Published host port, bound exclusively to 127.0.0.1.
HOST_PORT=8080
# Optional shared network for a containerized reverse proxy.
DOCKER_NETWORK=simple-bar-backend
# Host directory containing config.json (relative to compose.yaml or absolute).
CONFIG_DIR=./config
