{
  "name": "Simple-Bar-Calculator",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "moby": false
    }
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Simple-Bar-Calculator",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash scripts/setup-devcontainer.sh",
  "customizations": {
    "vscode": {
      "extensions": ["EditorConfig.EditorConfig", "esbenp.prettier-vscode"],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
